{
  "name": "xal-website",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "rm -rf dist && bun build src/index.html --outdir dist --minify --public-path=/ && bun scripts/prerender.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.11.2",
    "@types/bun": "^1.3.14",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "xal": "workspace:*"
  }
}
